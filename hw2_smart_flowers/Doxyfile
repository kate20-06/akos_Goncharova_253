# Doxygen configuration for the Smart Flowers project.

PROJECT_NAME           = "Smart Flowers"
PROJECT_BRIEF          = "Sequential simulation of smart flowers and gardeners"
OUTPUT_DIRECTORY       = docs

INPUT                  = include src
FILE_PATTERNS           = *.h *.c
RECURSIVE               = YES

EXTRACT_ALL             = YES
EXTRACT_STATIC          = YES
SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO

OPTIMIZE_OUTPUT_FOR_C   = YES
MARKDOWN_SUPPORT        = YES

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES

GENERATE_LATEX          = NO

QUIET                   = YES
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES

INPUT_ENCODING          = UTF-8
OUTPUT_LANGUAGE         = English

HAVE_DOT                = NO
